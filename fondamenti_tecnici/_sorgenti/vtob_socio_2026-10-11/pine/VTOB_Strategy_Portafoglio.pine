// Basato su "Volume-Trend Order Block Engine [BigBeluga]" — CC BY-NC-SA 4.0 — © BigBeluga (logica modificata)
// PORTAFOGLIO VTOB — scegli il preset in base al timeframe del grafico (backtest XAUUSD, spread reale):
//  A  M15  pivot 7/3,  EMA200 H1, trend>=20, solo long,  SL 6x vol, TP 3R, BE 1R  -> 199 trade, PF 2.03, +83R, DD 8.9R (lug22-ott26)
//  B  H1   pivot 10/3, EMA200 D1, trend>=10, long+short, SL 3x vol, TP 4R, BE 1R  -> 109 trade, PF 2.56, +70R, DD 6.7R (lug22-ott26)
//  C  M30  pivot 5/2,  EMA200 H4, trend>=20, long+short, SL 8x vol, TP 3R, BE 1R  -> 116 trade, PF 1.94, +44R, DD 4.3R (lug22-ott26)
//  D  M5   pivot 10/5, EMA200 H1, trend>=20, solo long,  SL 6x vol, TP 4R, BE 1R  -> 117 trade, PF 1.74, +42R, DD 8.0R (mag25-ott26)
//  Preset 'Personalizzato' = usa i valori manuali qui sotto.
// - OB: pivot 7 sinistra / 3 destra, zona alta 1x volatilità
// - Filtri obbligatori: trend avviato da >= 20 candele, OB oltre la linea di trend, prezzo dalla parte giusta della EMA200 H1
// - Ingresso: a mercato all'apertura della candela dopo la croce di retest (solo long di default)
// - Stop 6x volatilità, Target 3R, stop a pareggio (+0.1R) quando il massimo tocca +1R (attivo dalla candela dopo)

//@version=6
strategy('VTOB Portafoglio (preset A/B/C/D)', overlay = true, max_boxes_count = 500,
     initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.2, slippage = 10,
     process_orders_on_close = false, calc_on_every_tick = false)

// ── Input ─────────────────────────────────────────────────────────────
preset = input.string('A — M15', 'Preset', options = ['A — M15', 'B — H1', 'C — M30', 'D — M5', 'Personalizzato'])
g1 = 'Indicatore (solo per Personalizzato)'
st_len = input.int(50, 'Volatilità: SMA del range', group = g1)
st_mult = input.float(3.5, 'Supertrend multiplier', step = 0.1, group = g1)
piv_l = input.int(7, 'Pivot: candele a sinistra', minval = 1, group = g1)
piv_r = input.int(3, 'Pivot: candele a destra', minval = 1, group = g1)
g2 = 'Filtri OB (solo per Personalizzato)'
min_age = input.int(20, 'Trend avviato da almeno N candele', minval = 0, group = g2)
dist_mult = input.float(0.0, 'Distanza minima dalla linea di trend (x vol)', step = 0.25, group = g2)
htf_tf = input.timeframe('60', 'TF superiore', group = g2)
htf_len = input.int(200, 'EMA TF superiore', group = g2)
g3 = 'Gestione trade (solo per Personalizzato)'
allow_long = input.bool(true, 'Long', inline = 'd', group = g3)
allow_short = input.bool(false, 'Short', inline = 'd', group = g3)
sl_mult = input.float(6.0, 'Stop = X volte la volatilità', step = 0.5, group = g3)
rr = input.float(3.0, 'Target (R)', step = 0.5, group = g3)
be_r = input.float(1.0, 'Pareggio a +X R (0 = off)', step = 0.25, group = g3)
be_off = input.float(0.1, 'Offset pareggio (R)', step = 0.05, group = g3)
g4 = 'Generale'
start_t = input.time(timestamp('01 Jul 2022 00:00 +0000'), 'Backtest da', group = g4)

// ── Parametri effettivi del preset ────────────────────────────────────
bool pA = preset == 'A — M15'
bool pB = preset == 'B — H1'
bool pC = preset == 'C — M30'
bool pD = preset == 'D — M5'
bool pX = preset == 'Personalizzato'
int   e_pl   = pX ? piv_l     : pA ? 7 : pB ? 10 : pC ? 5 : 10
int   e_pr   = pX ? piv_r     : pA ? 3 : pB ? 3  : pC ? 2 : 5
int   e_age  = pX ? min_age   : pA ? 20 : pB ? 10 : pC ? 20 : 20
string e_htf = pX ? htf_tf    : pA ? '60' : pB ? 'D' : pC ? '240' : '60'
bool  e_long = pX ? allow_long : true
bool  e_shrt = pX ? allow_short : (pB or pC)
float e_sl   = pX ? sl_mult   : pA ? 6.0 : pB ? 3.0 : pC ? 8.0 : 6.0
float e_rr   = pX ? rr        : pA ? 3.0 : pB ? 4.0 : pC ? 3.0 : 4.0
float e_be   = pX ? be_r      : 1.0

// ── Supertrend custom (identico all'originale) ────────────────────────
src = hl2
vol_ = ta.sma(high - low, st_len)
ub = src + st_mult * vol_
lb = src - st_mult * vol_
pLB = nz(lb[1])
pUB = nz(ub[1])
lb := lb > pLB or close[1] < pLB ? lb : pLB
ub := ub < pUB or close[1] > pUB ? ub : pUB
int trend = na
float tstop = na
prevST = tstop[1]
if na(vol_[1])
    trend := 1
else if prevST == pUB
    trend := close > ub ? 1 : -1
else
    trend := close < lb ? -1 : 1
tstop := trend == 1 ? lb : ub
chg = trend != trend[1]

// ── Fattori ───────────────────────────────────────────────────────────
pl = ta.pivotlow(low, e_pl, e_pr)
ph = ta.pivothigh(high, e_pl, e_pr)
int age = nz(ta.barssince(chg), 100000)
float htf_ema = request.security(syminfo.tickerid, e_htf, ta.ema(close, htf_len)[1], lookahead = barmerge.lookahead_on)

var float a_top = na
var float a_bot = na
var int a_dir = 0
var int a_id = 0
var int traded_id = -1
var box b = na

overlap(float t, float bt) =>
    not (na(a_top) or na(a_bot)) and not (bt > a_top or t < a_bot)

// OB long
if trend == 1 and not na(pl)
    t = math.min(open[e_pr], close[e_pr])
    bt = t - vol_
    if not overlap(t, bt) and age >= e_age and bt - tstop >= dist_mult * vol_ and not na(htf_ema) and close > htf_ema
        a_top := t, a_bot := bt, a_dir := 1, a_id += 1
        b := box.new(bar_index - e_pr, t, bar_index, bt, bgcolor = color.new(#00ffcc, 82), border_color = color.new(#00ffcc, 40))
// OB short
if trend == -1 and not na(ph)
    bt = math.max(open[e_pr], close[e_pr])
    t = bt + vol_
    if not overlap(t, bt) and age >= e_age and tstop - t >= dist_mult * vol_ and not na(htf_ema) and close < htf_ema
        a_top := t, a_bot := bt, a_dir := -1, a_id += 1
        b := box.new(bar_index - e_pr, t, bar_index, bt, bgcolor = color.new(#ff007f, 82), border_color = color.new(#ff007f, 40))
// Rottura
if a_dir != 0 and ((a_dir == 1 and high < a_bot) or (a_dir == -1 and low > a_top))
    box.set_right(b, bar_index)
    box.set_bgcolor(b, color.new(color.gray, 85))
    a_top := na, a_bot := na, a_dir := 0, b := na
if not na(b)
    box.set_right(b, bar_index)

buy_sig = ta.crossover(low, a_top) and a_dir == 1 and na(pl) and not chg
sell_sig = ta.crossunder(high, a_bot) and a_dir == -1 and na(ph) and not chg

// ── Ordini ────────────────────────────────────────────────────────────
var float risk_px = na
var bool be_done = false
bool flat = strategy.position_size == 0
bool in_range = time >= start_t

if flat and in_range and traded_id != a_id
    if buy_sig and e_long
        risk_px := e_sl * vol_
        be_done := false
        traded_id := a_id
        strategy.entry('L', strategy.long)
        strategy.exit('XL', 'L', loss = risk_px / syminfo.mintick, profit = e_rr * risk_px / syminfo.mintick)
    else if sell_sig and e_shrt
        risk_px := e_sl * vol_
        be_done := false
        traded_id := a_id
        strategy.entry('S', strategy.short)
        strategy.exit('XS', 'S', loss = risk_px / syminfo.mintick, profit = e_rr * risk_px / syminfo.mintick)

// Pareggio: se il massimo (long) / minimo (short) della candela tocca +be_r R, lo stop va a ingresso + offset
if e_be > 0 and not be_done and strategy.position_size != 0
    float ep = strategy.position_avg_price
    if strategy.position_size > 0 and high >= ep + e_be * risk_px
        strategy.exit('XL', 'L', stop = ep + be_off * risk_px, limit = ep + e_rr * risk_px)
        be_done := true
    if strategy.position_size < 0 and low <= ep - e_be * risk_px
        strategy.exit('XS', 'S', stop = ep - be_off * risk_px, limit = ep - e_rr * risk_px)
        be_done := true

// ── Grafica ───────────────────────────────────────────────────────────
plot(chg ? na : tstop, 'Trend Stop', color = trend == 1 ? #00ffcc : #ff007f, style = plot.style_linebr)
plot(htf_ema, 'EMA TF superiore', color = color.new(color.orange, 30))
plotshape(buy_sig, 'Segnale long', shape.triangleup, location.belowbar, #00ffcc, size = size.tiny)
plotshape(sell_sig, 'Segnale short', shape.triangledown, location.abovebar, #ff007f, size = size.tiny)
plot(strategy.position_size != 0 ? strategy.position_avg_price - math.sign(strategy.position_size) * risk_px : na, 'SL iniziale', color.red, style = plot.style_linebr)
plot(strategy.position_size != 0 ? strategy.position_avg_price + math.sign(strategy.position_size) * e_rr * risk_px : na, 'TP', color.lime, style = plot.style_linebr)
