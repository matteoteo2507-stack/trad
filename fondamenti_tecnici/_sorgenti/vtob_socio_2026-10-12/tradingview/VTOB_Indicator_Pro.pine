// https://creativecommons.org/licenses/by-nc-sa/4.0/
// © BigBeluga — versione modificata con selezione OB a punteggio
//
// Differenze dall'originale:
// - Ogni OB riceve un PUNTEGGIO DI QUALITÀ calcolato nel momento in cui nasce (solo dati già disponibili, niente futuro).
// - Vengono disegnati solo gli OB con punteggio >= al minimo scelto. Gli altri non compaiono proprio.
// - Gli OB non vengono mai cancellati: quando il prezzo li sfonda si fermano lì e diventano grigi.
// - Croci di retest solo sugli OB selezionati, con filtro orario opzionale. Alert pronti.
// - Default scelti dal backtest su XAUUSD M15 (lug 2022 - ott 2026): fattori 2+3+4 attivi, punteggio minimo 3,
//   ingresso sulla croce di retest, stop 4x volatilità, target 1:2. Impulso e volume non hanno migliorato i risultati.
// - Pivot 7 a sinistra / 3 a destra: conferma in 3 candele invece di 7 (OB disegnato 45 min dopo il minimo/massimo
//   invece di 1h45 sul 15m). Zona alta 1x volatilità e ingresso sul bordo: le varianti testate andavano peggio.
// - Configurazione operativa migliore (backtest): Solo Long, ingresso alla croce, stop 6x volatilità, target 1:3,
//   stop a pareggio quando il prezzo fa +1R. Linea gialla tratteggiata = livello in cui spostare a pareggio.

// VTOB PRO v2 (pacchetto). Default = preset A consigliato (M15). Per B/C/D imposta i valori di docs/PORTAFOGLIO_VTOB.md.
// Preset A: solo long; croce di retest (a mercato); stop 6 x volatilità; target 3R; 50% a 1,5R poi stop a BE; BE a +1R (stop a +0.1R) | pivot 7/3, zona 1, fattori bcd (min 3), età trend 20, distanza 0, EMA200 H1
// Preset F2 (H1, tutte le condizioni): Supertrend 20/3,5, pivot 10/3, trend >= 10 candele, EMA100 H4, impulso >= 1 x vol,
// zona 1, long e short, stop 2 x volatilità, target 3R, niente pareggio, niente segnali se l'ATR D1 è sopra il 90° percentile.
// Trailing di F2 (da gestire a mano): sposta lo stop sulla linea Trend Stop quando è a favore e oltre lo stop attuale.
// Un trade per OB e una posizione alla volta, come nel backtest.
//@version=6
indicator('Volume-Trend Order Block Engine PRO [BigBeluga mod]', overlay = true, max_bars_back = 5000, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

preset_ind = input.string('Manuale (impostazioni sotto)', 'Preset', options = ['Manuale (impostazioni sotto)', 'M15 robusta 4 anni', 'M30 robusta 4 anni', 'H1 robusta 4 anni', 'F2 — H1 tutte le condizioni'], tooltip = 'F2 (grafico H1, solo demo): ricerca tutte le condizioni (report_tutte_condizioni.md). Non dimostrata: nel 2020-2024 ha perso, il guadagno viene dal 2025-26. Con il preset le impostazioni sotto vengono ignorate.')
gp_st = 'Custom Supertrend Settings'
i_st_len = input.int(50, title = 'Volatility SMA Length', group = gp_st)
i_st_mult = input.float(3.5, title = 'Multiplier', step = 0.1, group = gp_st)
show_fill = input.bool(true, title = 'Show Trend Cloud Fill', group = gp_st)

gp_cloud = 'Trend Cloud Settings'
cloud_bull_col = input.color(#00ffcc, title = 'Bullish Cloud Color', group = gp_cloud)
cloud_bear_col = input.color(#ff007f, title = 'Bearish Cloud Color', group = gp_cloud)

gp_ob = 'Order Block Settings'
i_pivot_left = input.int(7, title = 'Pivot: candele a sinistra', minval = 1, group = gp_ob, tooltip = 'Quante candele PRIMA del minimo/massimo devono essere meno estreme. Non crea ritardo.')
i_pivot_len = input.int(3, title = 'Pivot: candele a destra (ritardo conferma)', minval = 1, group = gp_ob, tooltip = 'Dopo quante candele l\'OB viene confermato e disegnato. Originale 7. Backtest: 3 dà risultati migliori e OB 4 candele prima.')
i_zona_h = input.float(1, title = 'Altezza OB (x volatilità)', step = 0.25, minval = 0.1, group = gp_ob)
bull_col = input.color(#00ffcc, title = 'Bullish OB Color', group = gp_ob)
bear_col = input.color(#ff007f, title = 'Bearish OB Color', group = gp_ob)
txt_col = input.color(#e0e0e0, title = 'OB Text Label Color', group = gp_ob)
broken_col = input.color(color.new(color.gray, 60), title = 'Colore OB sfondato', group = gp_ob)

gp_q = 'Selezione OB — Punteggio qualità'
i_min_score = input.int(3, title = 'Punteggio minimo per mostrare un OB', minval = 0, maxval = 5, group = gp_q, tooltip = 'Ogni fattore attivo che l\'OB rispetta vale 1 punto. Più alto = meno OB ma più selezionati. 0 = mostra tutti (come l\'originale).')
i_use_imp = input.bool(false, title = '1. Impulso: il prezzo è scappato dalla zona', inline = 'imp', group = gp_q, tooltip = 'Nelle candele di conferma il prezzo si è allontanato dall\'OB di almeno X volte la volatilità media. Zona da cui il mercato è ripartito con forza.')
i_imp_mult = input.float(1, title = 'x volatilità', step = 0.25, minval = 0.0, inline = 'imp', group = gp_q)
i_use_age = input.bool(true, title = '2. Trend già avviato (non appena girato)', inline = 'age', group = gp_q, tooltip = 'Il trend deve durare da almeno N candele. Gli OB nati subito dopo un cambio di trend sono più fragili.')
i_min_trend_bars = input.int(20, title = 'candele', minval = 0, inline = 'age', group = gp_q)
i_use_htf = input.bool(true, title = '3. D\'accordo col timeframe superiore', inline = 'htf', group = gp_q, tooltip = 'Long: prezzo sopra la EMA del TF superiore. Short: sotto. Usa la candela HTF già chiusa, quindi non ridisegna.')
i_htf_tf = input.timeframe('60', title = 'TF', inline = 'htf', group = gp_q)
i_htf_len = input.int(200, title = 'EMA', minval = 1, inline = 'htf', group = gp_q)
i_use_dist = input.bool(true, title = '4. Zona lontana dalla linea di trend', inline = 'dist', group = gp_q, tooltip = 'Tutto l\'OB deve stare oltre la linea Trend Stop di almeno X volte la volatilità. Una zona appoggiata sulla linea, se toccata, spesso gira il trend.')
i_dist_mult = input.float(0, title = 'x volatilità', step = 0.25, minval = 0.0, inline = 'dist', group = gp_q)
i_use_vol = input.bool(false, title = '5. Volume sopra la media sul pivot', inline = 'vol', group = gp_q, tooltip = 'La candela del pivot ha un volume almeno X volte la media delle 20 precedenti.')
vol_mult = input.float(1.2, title = 'x media', step = 0.1, minval = 0.0, inline = 'vol', group = gp_q)
show_score = input.bool(true, title = 'Scrivi il punteggio dentro l\'OB', group = gp_q)
show_rej = input.bool(false, title = 'Mostra in grigio gli OB scartati', group = gp_q)

gp_sig = 'Segnali di Retest'
show_bull_retest = input.bool(true, title = 'Segnali Long (croce)', inline = 'b', group = gp_sig)
bull_sig_col = input.color(#00ffcc, title = '', inline = 'b', group = gp_sig)
show_bear_retest = input.bool(true, title = 'Segnali Short (croce)', inline = 's', group = gp_sig)
bear_sig_col = input.color(#ff007f, title = '', inline = 's', group = gp_sig)
i_use_sess = input.bool(false, title = 'Segnali solo in questa fascia (ora italiana)', inline = 'ses', group = gp_sig)
sess = input.session('0900-1900', title = '', inline = 'ses', group = gp_sig)
show_htf_line = input.bool(false, title = 'Mostra EMA del timeframe superiore', group = gp_sig)
i_dir_mode = input.string('Solo Long', title = 'Direzione segnali', options = ['Long e Short', 'Solo Long', 'Solo Short'], group = gp_sig, tooltip = 'Nel backtest 2022-2026 gli short hanno perso anche con i filtri (oro in forte rialzo). Valuta Solo Long finché il trend di fondo resta rialzista.')
show_lvls = input.bool(true, title = 'Disegna Stop e Target sul segnale', group = gp_sig)
i_sl_mode = input.string('x ATR', 'Stop', options = ['x ATR', '$ fissi', 'Oltre OB + buffer ATR', 'Oltre swing + buffer ATR'], group = gp_sig)
i_sl_mult = input.float(6, title = 'Stop: valore (x volatilità, $, buffer x volatilità)', step = 0.25, group = gp_sig)
i_tp_mode = input.string('R:R', 'Target', options = ['R:R', '$ fissi', 'Swing precedente', 'Nessuno'], group = gp_sig)
i_rr = input.float(3, title = 'Target: valore (R, $, R minimo per lo swing)', step = 0.25, group = gp_sig)
i_p1_f = input.float(50, 'Parziale 1 % (0 = no)', inline = 'p1', group = gp_sig)
p1_r = input.float(1.5, 'a R', inline = 'p1', group = gp_sig)
i_p2_f = input.float(0, 'Parziale 2 % (0 = no)', inline = 'p2', group = gp_sig)
p2_r = input.float(0, 'a R', inline = 'p2', group = gp_sig)
i_be_r = input.float(1, title = 'Break-even a +X R (0 = off)', step = 0.25, minval = 0.0, inline = 'be', group = gp_sig)
be_o = input.float(0.1, title = 'stop a +R', step = 0.05, minval = 0.0, inline = 'be', group = gp_sig)
i_entry_lim = input.bool(false, 'Ingresso limit (disegna il livello sull\'OB)', inline = 'lim', group = gp_sig)
entry_frac = input.float(0, 'dentro la zona', step = 0.25, inline = 'lim', group = gp_sig)
lvl_len = input.int(96, title = 'Lunghezza linee (candele)', minval = 1, group = gp_sig)
i_vmax = input.int(100, title = 'Niente segnali se ATR D1 sopra il percentile (100 = off)', minval = 1, maxval = 100, group = gp_sig, tooltip = 'Percentile della volatilità ATR14 del giorno prima rispetto ai 250 giorni precedenti. F2 usa 90: niente ingressi nei giorni di volatilità estrema.')
i_vmin = input.int(0, title = 'Niente segnali se ATR D1 sotto il percentile (0 = off)', minval = 0, maxval = 99, group = gp_sig)
i_pend = input.float(-1, title = 'Solo nel verso della pendenza EMA50 D1 >= (-1 = off)', step = 0.01, group = gp_sig, tooltip = 'Pendenza della EMA50 D1 su 20 giorni divisa per 20 x ATR14 D1, del giorno prima. 0 = basta che sia a favore.')

// Valori effettivi: il preset F2 sostituisce le impostazioni manuali
bool pF2 = preset_ind == 'F2 — H1 tutte le condizioni'
bool pQ15 = preset_ind == 'M15 robusta 4 anni'
bool pQ30 = preset_ind == 'M30 robusta 4 anni'
bool pQ60 = preset_ind == 'H1 robusta 4 anni'
bool pQ = pQ15 or pQ30 or pQ60
st_len = pQ15 ? 100 : (pQ30 or pQ60) ? 50 : pF2 ? 20 : i_st_len
st_mult = pQ15 ? 3.5 : (pQ30 or pQ60) ? 5.0 : pF2 ? 3.5 : i_st_mult
pivot_left = pQ15 ? 7 : pQ30 ? 5 : pQ60 ? 10 : pF2 ? 10 : i_pivot_left
pivot_len = pQ30 ? 2 : (pQ15 or pQ60) ? 3 : pF2 ? 3 : i_pivot_len
zona_h = pQ15 ? 1.0 : (pQ30 or pQ60) ? 0.5 : pF2 ? 1.0 : i_zona_h
min_score = (pQ or pF2) ? 5 : i_min_score
use_imp = (pQ30 or pQ60 or pF2) ? true : pQ15 ? false : i_use_imp
imp_mult = pQ30 ? 0.5 : (pQ60 or pF2) ? 1.0 : i_imp_mult
use_age = (pQ or pF2) ? true : i_use_age
min_trend_bars = (pQ15 or pQ30) ? 20 : (pQ60 or pF2) ? 10 : i_min_trend_bars
use_htf = (pQ or pF2) ? true : i_use_htf
htf_tf = pQ15 ? 'D' : (pQ30 or pQ60 or pF2) ? '240' : i_htf_tf
htf_len = pQ ? 50 : pF2 ? 100 : i_htf_len
use_dist = (pQ or pF2) ? true : i_use_dist
dist_mult = (pQ or pF2) ? 0.0 : i_dist_mult
use_vol = pQ30 ? true : (pQ15 or pQ60 or pF2) ? false : i_use_vol
use_sess = (pQ or pF2) ? false : i_use_sess
dir_mode = (pQ15 or pQ30) ? 'Solo Long' : (pQ60 or pF2) ? 'Long e Short' : i_dir_mode
sl_mode = (pQ or pF2) ? 'x ATR' : i_sl_mode
sl_mult = pQ15 ? 8.0 : pQ30 ? 3.0 : (pQ60 or pF2) ? 2.0 : i_sl_mult
tp_mode = (pQ or pF2) ? 'R:R' : i_tp_mode
rr = pQ15 ? 2.0 : (pQ30 or pQ60 or pF2) ? 3.0 : i_rr
p1_f = pQ15 ? 33.33 : pQ30 ? 50.0 : (pQ60 or pF2) ? 0.0 : i_p1_f
p2_f = pQ15 ? 33.33 : (pQ30 or pQ60 or pF2) ? 0.0 : i_p2_f
be_r = (pQ15 or pQ60) ? 1.0 : (pQ30 or pF2) ? 0.0 : i_be_r
entry_lim = (pQ or pF2) ? false : i_entry_lim
vmax = pF2 ? 90 : pQ ? 100 : i_vmax
vmin = pQ ? 10 : pF2 ? 0 : i_vmin
pend_min = (pQ or pF2) ? -1.0 : i_pend
p1_r_e = pQ15 ? 1.0 : pQ30 ? 1.5 : p1_r
p2_r_e = pQ15 ? 2.0 : p2_r
vol_mult_e = pQ30 ? 1.2 : vol_mult

// }
// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
src = hl2
custom_atr = ta.sma(high - low, st_len)
upper_band = src + st_mult * custom_atr
lower_band = src - st_mult * custom_atr
prevLowerBand = nz(lower_band[1])
prevUpperBand = nz(upper_band[1])

lower_band := lower_band > prevLowerBand or close[1] < prevLowerBand ? lower_band : prevLowerBand
upper_band := upper_band < prevUpperBand or close[1] > prevUpperBand ? upper_band : prevUpperBand
int market_trend = na
float trend_stop = na
prevSuperTrend = trend_stop[1]
if na(custom_atr[1])
    market_trend := 1
else if prevSuperTrend == prevUpperBand
    market_trend := close > upper_band ? 1 : -1
else
    market_trend := close < lower_band ? -1 : 1
trend_stop := market_trend == 1 ? lower_band : upper_band

pivot_low = ta.pivotlow(low, pivot_left, pivot_len)
pivot_high = ta.pivothigh(high, pivot_left, pivot_len)

// --- Fattori per il punteggio (solo dati già chiusi al momento della conferma) ---
float hh_after = ta.highest(high, pivot_len)
float ll_after = ta.lowest(low, pivot_len)
int trend_age = nz(ta.barssince(market_trend != market_trend[1]), 100000)
float vol_avg = ta.sma(volume, 20)
bool vol_ok = not na(vol_avg[pivot_len + 1]) and volume[pivot_len] >= vol_mult_e * vol_avg[pivot_len + 1]
float htf_ema = request.security(syminfo.tickerid, htf_tf, ta.ema(close, htf_len)[1], lookahead = barmerge.lookahead_on)
bool in_sess = not na(time(timeframe.period, sess, 'Europe/Rome'))
float pend_d1 = request.security(syminfo.tickerid, 'D', (ta.ema(close, 50)[1] - ta.ema(close, 50)[21]) / (20 * ta.sma(ta.tr(true), 14)[1]), lookahead = barmerge.lookahead_on)
float vpct_d1 = request.security(syminfo.tickerid, 'D', ta.percentrank(ta.sma(ta.tr(true), 14), 250)[1], lookahead = barmerge.lookahead_on)
bool vol_d1_ok = (vmax >= 100 and vmin <= 0) or (not na(vpct_d1) and vpct_d1 <= vmax and vpct_d1 >= vmin)
bool d1_long_ok = vol_d1_ok and (pend_min < 0 or (not na(pend_d1) and (pend_min == 0 ? pend_d1 > 0 : pend_d1 >= pend_min)))
bool d1_short_ok = vol_d1_ok and (pend_min < 0 or (not na(pend_d1) and (pend_min == 0 ? pend_d1 < 0 : -pend_d1 >= pend_min)))

ob_score(int dir, float top, float bot) =>
    int sc = 0
    if use_imp and (dir == 1 ? hh_after - top >= imp_mult * custom_atr : bot - ll_after >= imp_mult * custom_atr)
        sc += 1
    if use_age and trend_age >= min_trend_bars
        sc += 1
    if use_htf and not na(htf_ema) and (dir == 1 ? close > htf_ema : close < htf_ema)
        sc += 1
    if use_dist and (dir == 1 ? bot - trend_stop >= dist_mult * custom_atr : trend_stop - top >= dist_mult * custom_atr)
        sc += 1
    if use_vol and vol_ok
        sc += 1
    sc

int max_score = (use_imp ? 1 : 0) + (use_age ? 1 : 0) + (use_htf ? 1 : 0) + (use_dist ? 1 : 0) + (use_vol ? 1 : 0)
int need_score = math.min(min_score, max_score)

var box active_top_box = na
var box active_bot_box = na
var float active_top = na
var float active_bot = na
var float active_buy_ratio = na
var int active_ob_trend = 0
var int active_score = 0
var int p_idx_sel = 0

is_overlapping(float new_top, float new_bot) =>
    if na(active_top) or na(active_bot)
        false
    else
        not(new_bot > active_top or new_top < active_bot)

p_idx = bar_index - pivot_len

get_window_volume_ratio(int lookback_len) =>
    float buy_vol = 0.0
    float sell_vol = 0.0
    for i = 0 to lookback_len by 1
        if close[i] >= open[i]
            buy_vol := buy_vol + volume[i]
        else
            sell_vol := sell_vol + volume[i]
    total_vol = buy_vol + sell_vol
    float buy_pct = total_vol > 0 ? buy_vol / total_vol : 0.5
    buy_pct

score_txt(int sc) =>
    show_score ? '  |  Q ' + str.tostring(sc) + '/' + str.tostring(max_score) : ''

draw_rejected(float top, float bot, int sc) =>
    if show_rej
        box.new(left = p_idx, top = top, right = bar_index, bottom = bot, bgcolor = color.new(color.gray, 88), border_color = color.new(color.gray, 60), border_style = line.style_dotted, text = 'Q ' + str.tostring(sc) + '/' + str.tostring(max_score), text_color = color.new(color.gray, 30), text_size = size.tiny, text_halign = text.align_right)

bool new_bull_ob = false
bool new_bear_ob = false

// 1. Uptrend Order Blocks
if market_trend == 1 and not na(pivot_low)
    ob_top = math.min(open[pivot_len], close[pivot_len])
    ob_bot = ob_top - zona_h * custom_atr
    if not is_overlapping(ob_top, ob_bot)
        int sc = ob_score(1, ob_top, ob_bot)
        if sc < need_score
            draw_rejected(ob_top, ob_bot, sc)
        else
            if not na(active_top_box)
                box.set_right(active_top_box, p_idx)
                box.set_right(active_bot_box, p_idx)
            active_top := ob_top
            active_bot := ob_bot
            active_ob_trend := 1
            p_idx_sel := p_idx
            active_score := sc
            new_bull_ob := true
            float buy_ratio = get_window_volume_ratio(7)
            active_buy_ratio := buy_ratio
            float split_price = active_bot + (active_top - active_bot) * buy_ratio
            string top_text = 'Sell: ' + str.tostring(math.round((1.0 - buy_ratio) * 100)) + '%' + score_txt(sc)
            string bot_text = 'Buy: ' + str.tostring(math.round(buy_ratio * 100)) + '%'
            active_top_box := box.new(left = p_idx, top = active_top, right = bar_index, bottom = split_price, bgcolor = color.new(bull_col, 85), border_color = color.new(bull_col, 40), text = top_text, text_color = txt_col, text_size = size.small, text_valign = text.align_center, text_halign = text.align_right)
            active_bot_box := box.new(left = p_idx, top = split_price, right = bar_index, bottom = active_bot, bgcolor = color.new(bull_col, 75), border_color = color.new(bull_col, 40), text = bot_text, text_color = txt_col, text_size = size.small, text_valign = text.align_center, text_halign = text.align_right)

// 2. Downtrend Order Blocks
if market_trend == -1 and not na(pivot_high)
    ob_bot = math.max(open[pivot_len], close[pivot_len])
    ob_top = ob_bot + zona_h * custom_atr
    if not is_overlapping(ob_top, ob_bot)
        int sc = ob_score(-1, ob_top, ob_bot)
        if sc < need_score
            draw_rejected(ob_top, ob_bot, sc)
        else
            if not na(active_top_box)
                box.set_right(active_top_box, p_idx)
                box.set_right(active_bot_box, p_idx)
            active_top := ob_top
            active_bot := ob_bot
            active_ob_trend := -1
            p_idx_sel := p_idx
            active_score := sc
            new_bear_ob := true
            float buy_ratio = get_window_volume_ratio(7)
            active_buy_ratio := buy_ratio
            float split_price = active_bot + (active_top - active_bot) * buy_ratio
            string top_text = 'Sell: ' + str.tostring(math.round((1.0 - buy_ratio) * 100)) + '%' + score_txt(sc)
            string bot_text = 'Buy: ' + str.tostring(math.round(buy_ratio * 100)) + '%'
            active_top_box := box.new(left = p_idx, top = active_top, right = bar_index, bottom = split_price, bgcolor = color.new(bear_col, 75), border_color = color.new(bear_col, 40), text = top_text, text_color = txt_col, text_size = size.small, text_valign = text.align_center, text_halign = text.align_right)
            active_bot_box := box.new(left = p_idx, top = split_price, right = bar_index, bottom = active_bot, bgcolor = color.new(bear_col, 85), border_color = color.new(bear_col, 40), text = bot_text, text_color = txt_col, text_size = size.small, text_valign = text.align_center, text_halign = text.align_right)

// OB sfondato: NON viene cancellato. Si ferma alla candela di rottura e diventa grigio; da lì niente più segnali su di lui.
if not na(active_top) and not na(active_bot)
    bool is_broken = (active_ob_trend == 1 and high < active_bot) or (active_ob_trend == -1 and low > active_top)
    if is_broken
        box.set_right(active_top_box, bar_index)
        box.set_right(active_bot_box, bar_index)
        box.set_border_color(active_top_box, broken_col)
        box.set_border_color(active_bot_box, broken_col)
        box.set_bgcolor(active_top_box, color.new(color.gray, 85))
        box.set_bgcolor(active_bot_box, color.new(color.gray, 80))
        active_top_box := na
        active_bot_box := na
        active_top := na
        active_bot := na
        active_ob_trend := 0

if not na(active_top_box) and not na(active_bot_box)
    box.set_right(active_top_box, bar_index)
    box.set_right(active_bot_box, bar_index)

// Segnali di retest (a candela chiusa) solo sugli OB selezionati
marketChange = market_trend != market_trend[1]
bool sess_ok = not use_sess or in_sess
bool long_dir = dir_mode != 'Solo Short'
bool short_dir = dir_mode != 'Solo Long'

bool buy_retest = ta.crossover(low, active_top) and show_bull_retest and active_ob_trend == 1 and na(pivot_low) and not na(active_top) and not marketChange and sess_ok and long_dir and d1_long_ok and barstate.isconfirmed
bool sell_retest = ta.crossunder(high, active_bot) and show_bear_retest and active_ob_trend == -1 and na(pivot_high) and not na(active_bot) and not marketChange and sess_ok and short_dir and d1_short_ok and barstate.isconfirmed

// }
// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{

st_plot = plot(market_trend != market_trend[1] ? float(na) : trend_stop, title = 'Trend Stop', color = market_trend == 1 ? cloud_bull_col : cloud_bear_col, linewidth = 1, style = plot.style_linebr)
price_plot = plot(close, title = 'Close Price Reference', display = display.none)
fill_color = show_fill ? market_trend == 1 ? color.new(cloud_bull_col, 80) : color.new(cloud_bear_col, 80) : na
fill(price_plot, st_plot, close, trend_stop, fill_color, color(na))

plot(show_htf_line ? htf_ema : na, title = 'EMA timeframe superiore', color = color.new(color.orange, 20), linewidth = 2)

plotshape(buy_retest, title = 'Retest Long', style = shape.cross, location = location.belowbar, color = bull_sig_col, size = size.tiny)
plotshape(sell_retest, title = 'Retest Short', style = shape.cross, location = location.abovebar, color = bear_sig_col, size = size.tiny)

// Stop e Target del segnale (ingresso indicativo = chiusura della candela del segnale)
// swing dell'OB selezionato (calcolati a ogni candela, servono a stop/target sullo swing)
int n_sel = math.min(math.max(bar_index - p_idx_sel + 1, 1), 4000)
float sw_hi_sel = ta.highest(high, n_sel)
float sw_lo_sel = ta.lowest(low, n_sel)
float piv_lo_sel = low[math.min(math.max(bar_index - p_idx_sel, 0), 4000)]
float piv_hi_sel = high[math.min(math.max(bar_index - p_idx_sel, 0), 4000)]

draw_levels(int d) =>
    float e = close
    float sl = sl_mode == 'x ATR' ? e - d * sl_mult * custom_atr : sl_mode == '$ fissi' ? e - d * sl_mult : sl_mode == 'Oltre OB + buffer ATR' ? (d == 1 ? active_bot - sl_mult * custom_atr : active_top + sl_mult * custom_atr) : (d == 1 ? piv_lo_sel - sl_mult * custom_atr : piv_hi_sel + sl_mult * custom_atr)
    float r = (e - sl) * d
    float tp = tp_mode == 'R:R' ? e + d * rr * r : tp_mode == '$ fissi' ? e + d * rr : tp_mode == 'Swing precedente' ? (d == 1 ? sw_hi_sel : sw_lo_sel) : na
    line.new(bar_index, e, bar_index + lvl_len, e, color = color.new(color.white, 30), style = line.style_dotted)
    line.new(bar_index, sl, bar_index + lvl_len, sl, color = color.new(color.red, 10), width = 2)
    label.new(bar_index + lvl_len, sl, 'SL ' + str.tostring(sl, format.mintick), style = label.style_label_left, color = color.new(color.red, 70), textcolor = color.white, size = size.tiny)
    if not na(tp)
        line.new(bar_index, tp, bar_index + lvl_len, tp, color = color.new(color.lime, 10), width = 2)
        label.new(bar_index + lvl_len, tp, 'TP ' + str.tostring(tp, format.mintick), style = label.style_label_left, color = color.new(color.lime, 70), textcolor = color.white, size = size.tiny)
    if be_r > 0
        float be = e + d * be_r * r
        line.new(bar_index, be, bar_index + lvl_len, be, color = color.new(color.yellow, 30), style = line.style_dashed)
        label.new(bar_index + lvl_len, be, 'BE ' + str.tostring(be, format.mintick) + ' -> stop ' + str.tostring(e + d * be_o * r, format.mintick), style = label.style_label_left, color = color.new(color.yellow, 75), textcolor = color.white, size = size.tiny)
    if p1_f > 0
        float p1 = e + d * p1_r_e * r
        line.new(bar_index, p1, bar_index + lvl_len, p1, color = color.new(color.aqua, 30), style = line.style_dashed)
        label.new(bar_index + lvl_len, p1, 'P1 ' + str.tostring(p1_f, '#') + '% ' + str.tostring(p1, format.mintick), style = label.style_label_left, color = color.new(color.aqua, 75), textcolor = color.white, size = size.tiny)
    if p2_f > 0
        float p2 = e + d * p2_r_e * r
        line.new(bar_index, p2, bar_index + lvl_len, p2, color = color.new(color.aqua, 30), style = line.style_dashed)
        label.new(bar_index + lvl_len, p2, 'P2 ' + str.tostring(p2_f, '#') + '% ' + str.tostring(p2, format.mintick), style = label.style_label_left, color = color.new(color.aqua, 75), textcolor = color.white, size = size.tiny)

if show_lvls and buy_retest
    draw_levels(1)
if show_lvls and sell_retest
    draw_levels(-1)

// ＡＬＥＲＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
alertcondition(new_bull_ob, title = 'Nuovo OB Long selezionato', message = '{{ticker}} {{interval}}: nuovo OB LONG di qualità')
alertcondition(new_bear_ob, title = 'Nuovo OB Short selezionato', message = '{{ticker}} {{interval}}: nuovo OB SHORT di qualità')
alertcondition(buy_retest, title = 'Retest Long', message = '{{ticker}} {{interval}}: retest LONG su OB selezionato')
alertcondition(sell_retest, title = 'Retest Short', message = '{{ticker}} {{interval}}: retest SHORT su OB selezionato')
// }

// livello dell'ordine limit sull'OB selezionato (se l'ingresso è limit)
bool nuovo_ob_sel = (new_bull_ob or new_bear_ob) and not na(active_top)
if entry_lim and nuovo_ob_sel
    float lim = active_ob_trend == 1 ? active_top - entry_frac * (active_top - active_bot) : active_bot + entry_frac * (active_top - active_bot)
    line.new(bar_index, lim, bar_index + lvl_len, lim, color = color.new(color.orange, 20), style = line.style_dashed)
    label.new(bar_index + lvl_len, lim, 'LIMIT ' + str.tostring(lim, format.mintick), style = label.style_label_left, color = color.new(color.orange, 70), textcolor = color.white, size = size.tiny)
alertcondition(entry_lim and nuovo_ob_sel, title = 'Limit sul nuovo OB', message = '{{ticker}} {{interval}}: nuovo OB selezionato, piazza il limit')
